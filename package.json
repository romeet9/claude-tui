{
  "name": "claude-tui",
  "version": "1.0.1",
  "description": "A full-screen terminal workspace for coding agents: Claude Code, Codex and Antigravity side by side.",
  "scripts": {
    "start": "tsx src/app.tsx",
    "demo": "node scripts/demo.mjs",
    "record-demo": "python3 scripts/record-demo.py",
    "typecheck": "tsc --noEmit",
    "build-release": "scripts/build-release.sh"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "antigravity",
    "tui",
    "ink",
    "terminal",
    "agents"
  ],
  "author": "Romeet Chatterjee",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.316",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ink": "^8.0.0",
    "marked": "^18.1.2",
    "marked-terminal": "^8.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "bin": {
    "claude-tui": "bin/claude-tui.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/romeet9/claude-tui.git"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin"
  ]
}
